{
  "name": "jobmanager",
  "version": "0.29.2",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "build:recorder": "mkdir -p bin && swiftc -O -o bin/JobRecorder recorder/JobRecorder.swift",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "auth:hash": "tsx scripts/hash-password.ts",
    "inbox:token": "tsx scripts/inbox-token.ts",
    "mcp:token": "tsx scripts/mcp-token.ts",
    "vault:key": "tsx scripts/vault-key.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.1",
    "jsdom": "^29.1.1",
    "next": "16.2.11",
    "playwright": "1.63.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
