# Copy to .env.local and fill in. .env* is gitignored.

# Your Custom GPT. Open it in ChatGPT and copy the URL from the address bar.
CUSTOM_GPT_URL=https://chatgpt.com/g/g-6a727130b8a88191a9cfdae38a33d230-resume-builder

# Shared secret between JobManager and the gateway. Pick anything random —
# without it, port 8000 is an open proxy to your ChatGPT account for anything
# running on this machine.
GATEWAY_TOKEN=change-me

# Your name, used to name generated resumes: <Name>_Resume_<Company>.pdf
RESUME_NAME=Vaman_Rajagopal

# Where the gateway listens. Rarely needs changing.
GATEWAY_URL=http://localhost:8000

# Chrome shows an "unsupported command-line flag: --host-resolver-rules" banner.
# That's upstream's Docker-only DNS workaround and is harmless — ignore it.
# Only set this to true if ChatGPT pages actually fail to load.
SKIP_HOST_RESOLVER_RULES=false

# If automatic PDF capture fails, the gateway waits this long for you to click
# the correct download button in the browser window. 0 disables the wait.
MANUAL_DOWNLOAD_WAIT_MS=60000
