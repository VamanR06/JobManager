# Copy to .env.local and fill in. .env* is gitignored.

# Your name, used to name generated resumes: <Name>_Resume_<Company>.pdf
RESUME_NAME=Your_Name

# ---- Application automation (Queue tab + `npm run worker`) ----
# Resume generation runs the Resume Builder plugin through your local Codex CLI
# login. No API key is needed or read here.

# Codex executable: a name on PATH or an absolute path.
CODEX_BIN=codex
# Required: the installed plugin, as <plugin name>@<marketplace>. See `codex plugin list`.
RESUME_PLUGIN_REF=
# Hard limit per Codex run (the run is stopped and retried/flagged after this).
CODEX_TIMEOUT_MS=900000
# Time budget stated to the plugin run, in minutes (soft target, not a kill).
RESUME_TARGET_MINUTES=7
# Reasoning effort for resume runs only, overriding ~/.codex/config.toml.
# low | medium | high; blank = inherit your Codex config.
CODEX_REASONING_EFFORT=medium
# Extra plugin runs when the dashboard's own checks find concrete problems.
RESUME_REPAIR_LIMIT=3
# Optional model override passed as `codex exec -m`. Blank = your Codex default.
CODEX_MODEL=
# Where private per-attempt Codex folders go. Blank = ~/.jobmanager/work
# (kept outside this repo on purpose).
JOBMANAGER_WORK_ROOT=
# Hostnames besides localhost/127.0.0.1 allowed to reach the app (comma-separated).
# Ignored once JOBMANAGER_PASSWORD_HASH is set.
JOBMANAGER_ALLOWED_HOSTS=

# ---- Claude Code as an alternative resume engine ----
# Pick Codex or Claude on the Queue page (stored in the DB). RESUME_ENGINE is
# only the fallback before you've picked. Claude runs use your Claude Code login
# (`claude auth login`); no API key is read here.
RESUME_ENGINE=codex
CLAUDE_BIN=claude
# Optional --model for Claude runs; blank = the CLI default.
CLAUDE_MODEL=
# --effort for Claude runs: low | medium | high | xhigh | max; blank = CLI default.
CLAUDE_EFFORT=medium

# ---- Form filling (worker) ----
# 1 = run the automation browser headless. Leave unset: the window should be visible
# so you can review and submit, and take over for logins/CAPTCHAs.
JOBMANAGER_BROWSER_HEADLESS=

# ---- Parallelism (worker) ----
# How many of each run at once, across all workers. More resume runs finish a
# batch sooner but spend Codex/Claude usage faster (a usage-limit hit pauses them all).
RESUME_CONCURRENCY=2
# Forms filled at once, one tab each in the automation window.
FORM_CONCURRENCY=2
# Posting fetches at once.
FETCH_CONCURRENCY=3

# ---- Password (deployed use) ----
# Set this to put every page and API route behind a sign-in page. Generate it with
# `npm run auth:hash`. Blank = local-only mode, no login.
JOBMANAGER_PASSWORD_HASH=
